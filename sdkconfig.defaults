CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_FREERTOS_HZ=1000
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FATFS_LFN_HEAP=y
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
CONFIG_HTTPD_WS_SUPPORT=n
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
# Wi-Fi and lwIP buffers in PSRAM: under 4 parallel guide reads their internal-RAM use took the minimum free to 19 KB (ADR 0005).
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Quad I/O flash (Winbond, quad-capable): catch-up 30.5x -> 31.2x, boot ~80 ms sooner.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
