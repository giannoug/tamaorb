menu "TamaOrb board"
choice TAMAORB_BOARD
    prompt "Target board"
    default TAMAORB_BOARD_SPOTPEAR_BALL_128
config TAMAORB_BOARD_SPOTPEAR_BALL_128
    bool "SpotPear 1.28\" AI Voice Robot Ball (ESP32-S3, GC9A01A, CST816D, ES8311)"
endchoice
config TAMAORB_VOLUME
    int "Speaker volume (0 = muted, speaker amp off)"
    range 0 100
    default 0
    help
        0 mutes the sound and switches the speaker amp off, which also removes its idle hum.
endmenu
